{
  "name": "@redjay/app-bus",
  "version": "3.0.0",
  "description": "A dependency-free application event bus with typed publish/subscribe for JavaScript and TypeScript.",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.cts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/write-esm-package.js",
    "build": "npm run build:cjs && npm run build:esm",
    "test:types": "tsc -p tsconfig.types.json",
    "test": "npm run build && npm run test:unit && npm run test:types",
    "prepack": "npm run build",
    "prepublishOnly": "npm audit --audit-level=high && npm run lint && npm test && publint",
    "release": "node scripts/publish.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.esm.json --noEmit",
    "test:unit": "mocha \"test/**/*.js\"",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=lcov --include=dist/cjs/**/*.js --check-coverage --lines 95 --branches 90 --functions 95 --statements 95 mocha \"test/**/*.js\"",
    "check:package": "npm run build && publint && attw --pack . && node scripts/smoke-package.js",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:types && npm run check:package && npm run release:notes",
    "release:notes": "node scripts/release-notes.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaRamirez/AppBus.git"
  },
  "keywords": [
    "Events",
    "Pub",
    "Sub",
    "Publish",
    "Subscribe",
    "Publications",
    "Subscriptions",
    "Bus",
    "event-bus",
    "pubsub",
    "typescript",
    "typed-events"
  ],
  "author": "Joshua Ramirez",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JoshuaRamirez/AppBus/issues"
  },
  "homepage": "https://github.com/JoshuaRamirez/AppBus#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.1",
    "@types/node": "^26.4.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.9.1",
    "mocha": "^12.0.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
